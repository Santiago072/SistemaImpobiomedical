# ==============================================================================
# SISTEMA IMPOBIOMEDICAL — Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# Instrucciones de uso:
# 1. Copia este archivo con el nombre '.env' dentro de esta misma carpeta 'config/'
#    Comando en consola: cp config/.env.example config/.env
# 2. Modifica los valores según tu entorno (XAMPP local, Docker o Producción).
# 3. NUNCA subas el archivo '.env' real al repositorio (está protegido en .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (MySQL / MariaDB)
# ------------------------------------------------------------------------------
# DB_HOST:
#   - En XAMPP local: 'localhost' o '127.0.0.1'
#   - En Docker: 'impobiomedical_db' (nombre del contenedor en docker-compose)
#   - En VPS/Hosting: IP o nombre de host provisto por el servidor de BD
DB_HOST=localhost

# DB_USER:
#   - En XAMPP local: por defecto es 'root'
#   - En Docker: 'impo_user' (configurado en docker-compose.yml)
DB_USER=root

# DB_PASS:
#   - En XAMPP local: normalmente está vacío (dejar en blanco)
#   - En Docker / Producción: la contraseña asignada al usuario
DB_PASS=

# DB_NAME: Nombre de la base de datos creada con el script config/bd.sql
DB_NAME=sistema_impobiomedical


# ------------------------------------------------------------------------------
# 2. ENRUTAMIENTO Y URL BASE (APP_BASE)
# ------------------------------------------------------------------------------
# Define el prefijo de la URL de la aplicación:
#   - En XAMPP local: dejar vacío (APP_BASE=) para que el sistema autodetecte
#     automáticamente '/SistemaImpobiomedical/' según la carpeta de htdocs.
#   - En Docker o servidor con VirtualHost dedicado en la raíz: usar '/'
#   - En subcarpeta fija en servidor: ej. '/sistema/'
APP_BASE=


# ------------------------------------------------------------------------------
# 3. SEGURIDAD Y SESIONES PHP
# ------------------------------------------------------------------------------
# SESSION_LIFETIME: Tiempo máximo de inactividad de sesión en segundos.
#   - 3600 = 1 hora (recomendado para uso administrativo y comercial diario)
#   - 7200 = 2 horas
SESSION_LIFETIME=3600

# COOKIE_SECURE: Transmisión exclusiva de cookies sobre HTTPS.
#   - 0 = Desactivado (OBLIGATORIO en entornos locales HTTP como XAMPP sin SSL)
#   - 1 = Activado (OBLIGATORIO en Producción con certificado SSL / HTTPS activo)
COOKIE_SECURE=0


# ------------------------------------------------------------------------------
# 4. CARGA Y GESTIÓN DE ARCHIVOS (Imágenes y Adjuntos)
# ------------------------------------------------------------------------------
# UPLOAD_MAX_SIZE: Límite máximo en bytes por archivo subido (fotos, respaldos).
#   - 2097152  = 2 MB
#   - 5242880  = 5 MB (predeterminado recomendado)
#   - 8388608  = 8 MB
# Nota: Debe ser menor o igual a 'upload_max_filesize' y 'post_max_size' en php.ini.
UPLOAD_MAX_SIZE=5242880

# ALLOWED_EXTENSIONS: Extensiones de archivos permitidas separadas por coma.
# Solo se admiten formatos de imagen web seguros para evitar subida de scripts.
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp
